rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidEmail(email) {
      return email is string && email.size() > 3 && email.size() < 300;
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             isValidEmail(data.email);
    }

    function isValidScan(data) {
      return data.uid == request.auth.uid &&
             data.input is string && data.input.size() <= 10000 &&
             data.confidence is number &&
             data.tone is string &&
             data.behavior is string &&
             data.decisionQuality is string &&
             data.sentiment is string;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;

      // Scans subcollection
      match /scans/{scanId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidScan(request.resource.data);
        allow update: if isOwner(userId) && isValidScan(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Any other sub-collection (goals, settings etc.)
      match /{subCollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
